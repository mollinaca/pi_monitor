{
  "annotations": { "list": [] },
  "description": "Fixed-server Ookla measurements from the Raspberry Pi wired eth0 interface.",
  "editable": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "green" }, "mappings": [ { "options": { "0": { "color": "red", "text": "NG" }, "1": { "color": "green", "text": "OK" } }, "type": "value" } ], "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 0 }, "id": 1,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "expr": "home_internet_speedtest_probe_success{job=\"internet-speed\"}", "refId": "A" } ], "title": "Latest test", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsLocal" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 0 }, "id": 2,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false } },
      "targets": [ { "expr": "home_internet_speedtest_probe_timestamp_seconds{job=\"internet-speed\"}", "refId": "A" } ], "title": "Last test attempt", "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "auto" }, "unit": "Bps" }, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 7 }, "id": 3,
      "options": { "legend": { "calcs": [ "lastNotNull", "min", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "home_internet_speedtest_download_bytes_per_second{job=\"internet-speed\"}", "legendFormat": "download", "refId": "A" }, { "expr": "home_internet_speedtest_upload_bytes_per_second{job=\"internet-speed\"}", "legendFormat": "upload", "refId": "B" } ], "title": "Internet throughput", "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "showPoints": "auto" }, "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 }, "id": 4,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "home_internet_speedtest_ping_latency_milliseconds{job=\"internet-speed\"}", "legendFormat": "idle latency", "refId": "A" }, { "expr": "home_internet_speedtest_ping_jitter_milliseconds{job=\"internet-speed\"}", "legendFormat": "jitter", "refId": "B" } ], "title": "Idle latency and jitter", "type": "timeseries"
    }
  ],
  "refresh": "1m", "schemaVersion": 42, "tags": [ "internet", "speedtest", "ookla" ], "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" }, "timepicker": {}, "timezone": "browser", "title": "Internet Speed", "uid": "internet-speed", "version": 1
}
