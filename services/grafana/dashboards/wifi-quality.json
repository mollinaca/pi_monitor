      "targets": [ { "expr": "home_wifi_association_duration_seconds{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}}", "refId": "A" }, { "expr": "home_wifi_probe_duration_seconds{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}} total", "refId": "B" } ],
