      "targets": [ { "expr": "home_wifi_rx_bitrate_mbps{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}} RX", "refId": "A" }, { "expr": "home_wifi_tx_bitrate_mbps{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}} TX", "refId": "B" } ],
      "title": "Link bitrate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
