        "label": "Target",
        "multi": true,
        "name": "target",
        "options": [],
        "query": { "query": "label_values(home_wifi_probe_success, target)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
