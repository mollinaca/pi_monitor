      "targets": [ { "expr": "home_wifi_gateway_latency_seconds{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}} gateway", "refId": "A" }, { "expr": "home_wifi_internet_latency_seconds{target=~\"$target\"}", "legendFormat": "{{ap}} {{band}} internet", "refId": "B" } ],
