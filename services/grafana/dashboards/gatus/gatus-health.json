{
  "annotations": { "list": [] },
  "description": "Gatus endpoint health and response time history. Gatus runs LAN checks every 30 seconds and internet checks every 5 minutes.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "mappings": [ { "options": { "0": { "color": "red", "text": "NG" }, "1": { "color": "green", "text": "OK" } }, "type": "value" } ], "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "alignValue": "center", "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "mergeValues": true, "rowHeight": 0.9, "showValue": "always", "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "gatus_results_endpoint_success{group=\"01-LAN\", name=~\"$endpoint\"}", "legendFormat": "{{name}}", "refId": "A" } ],
      "title": "LAN health",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "fixedColor": "green", "mode": "fixed" }, "mappings": [ { "options": { "0": { "color": "red", "text": "NG" }, "1": { "color": "green", "text": "OK" } }, "type": "value" } ], "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 8 },
      "id": 2,
      "options": { "alignValue": "center", "legend": { "calcs": [ "lastNotNull" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "mergeValues": true, "rowHeight": 0.9, "showValue": "always", "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "gatus_results_endpoint_success{group=\"02-INTERNET\", name=~\"$endpoint\"}", "legendFormat": "{{name}}", "refId": "A" } ],
      "title": "Internet health",
      "type": "state-timeline"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "pointSize": 4, "showPoints": "auto" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 20 },
      "id": 3,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "gatus_results_duration_seconds{group=\"01-LAN\", name=~\"$endpoint\"}", "legendFormat": "{{name}}", "refId": "A" } ],
      "title": "LAN response time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "lineWidth": 2, "pointSize": 4, "showPoints": "auto" }, "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 20 },
      "id": 4,
      "options": { "legend": { "calcs": [ "lastNotNull", "max" ], "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "none" } },
      "targets": [ { "expr": "gatus_results_duration_seconds{group=\"02-INTERNET\", name=~\"$endpoint\"}", "legendFormat": "{{name}}", "refId": "A" } ],
      "title": "Internet response time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 3, "max": 100, "min": 0, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 99 }, { "color": "green", "value": 99.9 } ] }, "unit": "percent" }, "overrides": [] },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 29 },
      "id": 5,
      "options": { "displayMode": "gradient", "minVizWidth": 20, "minVizHeight": 16, "namePlacement": "left", "orientation": "horizontal", "reduceOptions": { "calcs": [ "lastNotNull" ], "fields": "", "values": false }, "showUnfilled": true, "sizing": "auto", "valueMode": "color" },
      "targets": [ { "expr": "avg_over_time(gatus_results_endpoint_success{name=~\"$endpoint\"}[$__range]) * 100", "instant": true, "legendFormat": "{{group}} / {{name}}", "refId": "A" } ],
      "title": "Availability over selected time range",
      "type": "bargauge"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [ "gatus", "network", "health" ],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "text": "All", "value": [ "$__all" ] },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(gatus_results_endpoint_success, name)",
        "includeAll": true,
        "label": "Endpoint",
        "multi": true,
        "name": "endpoint",
        "options": [],
        "query": { "query": "label_values(gatus_results_endpoint_success, name)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Gatus Health",
  "uid": "gatus-health",
  "version": 1
}
